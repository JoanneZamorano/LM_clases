<?xml version="1.0" encoding="UTF-8"?>
<!--Cardinalidad:
    ?: uno o ninguna vez
    *: de 0 a N veces
    +: de 1 a N veces
    nada(por defecto): 1 vez
-->
<!DOCTYPE casas_rurales [
    <!ELEMENT casas_rurales (casa+)>
    <!ELEMENT casa (direccion, descripcion?, estado, (tamanio | hectareas), disponible?)>
    <!ELEMENT direccion (#PCDATA)>
    <!ELEMENT descripcion (#PCDATA)>
    <!ELEMENT estado (#PCDATA)>
    <!ELEMENT tamanio (#PCDATA)>
    <!ELEMENT hectareas (#PCDATA)>
    <!ELEMENT disponible EMPTY>
]>

<casas_rurales>
    <casa>
